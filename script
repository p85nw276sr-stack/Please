-- Деталь с точкой вращения в начале (AnchorPoint по X), дочерние детали вращаются вместе с ней
local function limb(parent, pos, len, thick, rot, color, anchorX)
	local f = new("Frame", {
		AnchorPoint = Vector2.new(anchorX or 0, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(len, thick),
		Rotation = rot,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, parent)
	corner(f, math.max(1, thick / 2))
	return f
end

local function newDragon(colorKey, phase, tilt)
	local d = { colorKey = colorKey, phase = phase, tilt = tilt, segs = {}, spikes = {}, pts = {}, plume = {}, whisk = {} }
	local pale = rgb(255, 238, 190)

	-- тело: от хвоста к голове (голова рисуется поверх)
	for i = DRAGON_N, 1, -1 do
		local seg = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
		}, fab)
		roundCorner(seg)
		stroke(seg, Color3.new(0, 0, 0), 1, 0.5)
		local belly = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.45, 0.45),
			BackgroundColor3 = rgb(255, 232, 176),
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
		}, seg)
		roundCorner(belly)
		d.segs[i] = seg
		-- спинные шипы
		if i % 2 == 1 and i <= DRAGON_N - 3 then
			d.spikes[i] = limb(seg, UDim2.fromScale(0.5, 0.5), 6, 2, 0, pale, -0.55)
		end
	end

	-- веер на кончике хвоста
	local tail = d.segs[DRAGON_N]
	for k = 1, 3 do
		d.plume[k] = limb(
			tail, UDim2.fromScale(0.5, 0.5),
			(k == 1) and 11 or 8, (k == 1) and 2.2 or 1.6, 0, pale
		)
	end

	-- голова: 18x12, "перёд" смотрит в сторону Rotation = 0
	local head = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(18, 12),
		BorderSizePixel = 0,
	}, fab)
	corner(head, 6)
	d.head = head
	d.headScale = new("UIScale", {}, head)

	d.snout = new("Frame", {
		Position = UDim2.fromOffset(12, 3),
		Size = UDim2.fromOffset(9, 7),
		BorderSizePixel = 0,
	}, head)
	corner(d.snout, 3)
	d.jaw = limb(head, UDim2.fromOffset(11, 10.5), 10, 3.2, 8, Color3.new(1, 1, 1))
	new("Frame", {
		Position = UDim2.fromOffset(18, 4.2), Size = UDim2.fromOffset(1.8, 1.8),
		BackgroundColor3 = rgb(40, 15, 15), BorderSizePixel = 0,
	}, head)

	-- глаз и бровь
	local eye = new("Frame", {
		Position = UDim2.fromOffset(7, 2.2), Size = UDim2.fromOffset(4.6, 4.6),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
	}, head)
	roundCorner(eye)
	local pupil = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.62, 0.5),
		Size = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = rgb(25, 8, 8), BorderSizePixel = 0,
	}, eye)
	roundCorner(pupil)
	d.brow = limb(head, UDim2.fromOffset(5.5, 1.8), 6.5, 1.6, 18, Color3.new(0, 0, 0))

	-- рога (две секции, изгиб)
	local topHorn = limb(head, UDim2.fromOffset(4, 1.5), 9, 2.6, 205, pale)
	limb(topHorn, UDim2.new(1, 0, 0.5, 0), 7, 1.9, 28, pale)
	local botHorn = limb(head, UDim2.fromOffset(4, 10.5), 9, 2.6, 155, pale)
	limb(botHorn, UDim2.new(1, 0, 0.5, 0), 7, 1.9, -28, pale)

	-- усы (три секции, колышутся)
	for side = 1, 2 do
		local sgn = (side == 1) and 1 or -1
		local p1 = limb(head, UDim2.fromOffset(17, side == 1 and 3.2 or 8.8), 9, 1.5, -28 * sgn, pale)
		local p2 = limb(p1, UDim2.new(1, 0, 0.5, 0), 8, 1.2, -10 * sgn, pale)
		local p3 = limb(p2, UDim2.new(1, 0, 0.5, 0), 7, 1, 18 * sgn, pale)
		d.whisk[side] = { p1, p2, p3 }
	end
	return d
end

local function colorDragon(d)
	local main = THEME[d.colorKey]
	local dark = main:Lerp(Color3.new(0, 0, 0), 0.55)
	for i, seg in ipairs(d.segs) do
		local t = (i - 1) / (DRAGON_N - 1)
		local c = main:Lerp(dark, t * 0.75)
		if i % 2 == 0 then c = c:Lerp(Color3.new(1, 1, 1), 0.1) end
		seg.BackgroundColor3 = c
	end
	d.head.BackgroundColor3 = main:Lerp(Color3.new(1, 1, 1), 0.12)
	d.snout.BackgroundColor3 = main:Lerp(Color3.new(1, 1, 1), 0.22)
	d.jaw.BackgroundColor3 = main:Lerp(dark, 0.35)
end

