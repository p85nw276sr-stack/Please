----------------------------------------------------------------
-- Главный цикл анимаций
----------------------------------------------------------------
local startClock = os.clock()
local dClock, dSpeed = 0, 1.8

connect(RunService.RenderStepped, function(dt)
	local t = os.clock() - startClock

	-- драконы: быстрее, когда меню закрыто, и спокойнее, когда открыто
	local targetSpeed = menuVisible and 1.1 or 1.9
	dSpeed = dSpeed + (targetSpeed - dSpeed) * math.clamp(dt * 3, 0, 1)
	dClock = dClock + dt * dSpeed
	for _, d in ipairs(dragons) do updateDragon(d, dClock) end

	-- жемчужина: «дыхание», переливы, блик, мерцание
	pearlScale.Scale = 1 + math.sin(t * 2.2) * 0.04
	pearlGrad.Rotation = (45 + t * 70) % 360
	gloss.BackgroundTransparency = 0.7 + math.sin(t * 2.2) * 0.1
	local ph = (t * 0.7) % 1
	halo.Size = UDim2.fromOffset(48 + ph * 30, 48 + ph * 30)
	haloStroke.Transparency = 0.25 + ph * 0.75
	for _, s in ipairs(sparkles) do
		local k = (math.sin(t * 2.4 + s.ph) + 1) / 2
		s.f.Size = UDim2.fromOffset(2 + k * 4, 2 + k * 4)
		s.f.BackgroundTransparency = 0.15 + (1 - k) * 0.8
	end

	if not root.Visible then return end

	-- вращающаяся рамка, блик на заголовке, дыхание индикатора
	borderGrad.Rotation = (t * 45) % 360
	titleGrad.Offset = Vector2.new(((t * 0.5) % 2) - 1, 0)
	indicator.BackgroundTransparency = 0.8 + math.sin(t * 2.5) * 0.05
	watermark.Rotation = math.sin(t * 0.7) * 5

	-- искры поднимаются вверх
	if State.particles then
		for _, p in ipairs(particles) do
			p.prog = p.prog + dt * p.speed
			if p.prog > 1 then
				p.prog = 0
				p.x = math.random()
			end
			p.f.Position = UDim2.fromScale(
				p.x + math.sin(t * 1.2 + p.phase) * p.amp,
				1.05 - p.prog * 1.1
			)
			p.f.BackgroundTransparency = 1 - math.sin(p.prog * math.pi) * 0.7
		end
	end
end)

