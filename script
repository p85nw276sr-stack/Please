			TextSize = 30,
			TextColor3 = (i <= 9) and THEME.accent2 or THEME.accent,
			TextTransparency = 1,
			LayoutOrder = i,
		}, row)
		letters[i] = { lb = lb, sc = new("UIScale", { Scale = 0 }, lb) }
	end

	local underline = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(200, 224),
		Size = UDim2.fromOffset(0, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, box)
	accentGradient(underline, 0)

	local sub = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(200, 242),
		Size = UDim2.fromOffset(300, 16),
		BackgroundTransparency = 1,
		Text = "dragon edition  v2.1",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = THEME.sub,
		TextTransparency = 1,
	}, box)
	local status = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(200, 268),
		Size = UDim2.fromOffset(300, 14),
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = THEME.accent2,
		TextTransparency = 1,
	}, box)
	local track = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(200, 286),
		Size = UDim2.fromOffset(220, 4),
		BackgroundColor3 = THEME.off,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, box)
	roundCorner(track)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, track)
	roundCorner(fill)
	accentGradient(fill, 0)

	-- 1) затемнение, жемчужина вылетает в центр
	tween(dim, 0.4, { BackgroundTransparency = 0.3 })
	task.wait(0.15)
	fab.Position = UDim2.new(0.5, 0, 0.5, -55 * k)
	tween(fabScale, 0.8, { Scale = 1.7 * k }, Enum.EasingStyle.Back)
	task.wait(0.5)

	-- 2) буквы выскакивают по очереди
	for i, L in ipairs(letters) do
		task.delay(i * 0.045, function()
			tween(L.sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
			tween(L.lb, 0.3, { TextTransparency = 0 })
		end)
	end
	task.wait(0.5)
	tween(underline, 0.7, { Size = UDim2.fromOffset(240, 2) })
	tween(sub, 0.5, { TextTransparency = 0.2 })
	tween(status, 0.4, { TextTransparency = 0 })
	tween(track, 0.4, { BackgroundTransparency = 0.4 })
	task.wait(0.3)

	-- 3) полоса загрузки
	local steps = { "Initializing...", "Loading modules...", "Building interface...", "Ready" }
	tween(fill, 1.3, { Size = UDim2.fromScale(1, 1) }, Enum.EasingStyle.Sine)
	for i, s in ipairs(steps) do
		status.Text = s
		task.wait(i == #steps and 0.25 or 0.32)
	end

	-- 4) всё исчезает, жемчужина летит на своё место
	for _, L in ipairs(letters) do
		tween(L.sc, 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tween(L.lb, 0.3, { TextTransparency = 1 })
	end
	tween(underline, 0.4, { Size = UDim2.fromOffset(0, 2) })
	tween(sub, 0.3, { TextTransparency = 1 })
	tween(status, 0.3, { TextTransparency = 1 })
	tween(track, 0.3, { BackgroundTransparency = 1 })
	tween(fill, 0.3, { BackgroundTransparency = 1 })
	tween(dim, 0.6, { BackgroundTransparency = 1 })
	tween(fabScale, 0.8, { Scale = 1 }, Enum.EasingStyle.Quint)
	tween(fab, 0.8, { Position = UDim2.new(0, 60, 0.5, 0) }, Enum.EasingStyle.Quint)
	task.wait(0.85)
	layer:Destroy()
end

