	-- Сегментированный выбор (несколько вариантов)
	function tab.Choice(text, options, default, callback)
		local row = baseRow(58)
		rowLabel(row, text, 6, 1)
		local seg = new("Frame", {
			Position = UDim2.new(0, 14, 0, 30),
			Size = UDim2.new(1, -28, 0, 22),
			BackgroundColor3 = "@off",
			BackgroundTransparency = 0.35,
		}, row)
		corner(seg, 8)
		local n = #options
		local hl = new("Frame", {
			Size = UDim2.new(1 / n, -4, 1, -4),
			Position = UDim2.new(0, 2, 0, 2),
			BackgroundColor3 = "@accent",
			BorderSizePixel = 0,
		}, seg)
		corner(hl, 6)
		local buttons, current = {}, nil
		local function select(name, silent)
			current = name
			for i, opt in ipairs(options) do
				local on = (opt == name)
				if on then
					tween(hl, 0.35, { Position = UDim2.new((i - 1) / n, 2, 0, 2) }, Enum.EasingStyle.Back)
				end
				tween(buttons[opt], 0.25, { TextColor3 = on and THEME.text or THEME.sub })
			end
			if not silent then task.spawn(callback, name) end
		end
		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				Position = UDim2.new((i - 1) / n, 0, 0, 0),
				Size = UDim2.new(1 / n, 0, 1, 0),
				BackgroundTransparency = 1,
				Text = opt,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = THEME.sub,
				AutoButtonColor = false,
				ZIndex = 3,
			}, seg)
			buttons[opt] = b
			connect(b.MouseButton1Click, function() select(opt) end)
		end
		table.insert(refreshers, function()
			for _, opt in ipairs(options) do
				tween(buttons[opt], 0.3, { TextColor3 = (opt == current) and THEME.text or THEME.sub })
			end
		end)
		select(default, true)
	end

	-- Кружки-образцы. list = { {name=, seq=ColorSequence}, ... }
	function tab.ColorPick(text, list, default, callback)
		local row = baseRow(68)
		rowLabel(row, text, 8, 0.5)
		local valueLabel = rowValue(row, 8)
		local buttons = {}
		local function select(name, silent)
			valueLabel.Text = name
			for n, b in pairs(buttons) do
				local on = (n == name)
				tween(b.stroke, 0.25, { Transparency = on and 0 or 0.85 })
				tween(b.scale, 0.35, { Scale = on and 1.2 or 1 }, Enum.EasingStyle.Back)
			end
			if not silent then task.spawn(callback, name) end
		end
		for i, entry in ipairs(list) do
			local sw = new("TextButton", {
				Position = UDim2.fromOffset(16 + (i - 1) * 26, 38),
				Size = UDim2.fromOffset(20, 20),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Text = "",
				AutoButtonColor = false,
				ZIndex = 3,
			}, row)
			roundCorner(sw)
			new("UIGradient", { Color = entry.seq, Rotation = 45 }, sw)
			buttons[entry.name] = {
				stroke = stroke(sw, Color3.new(1, 1, 1), 2, 0.85),
				scale = new("UIScale", {}, sw),
			}
			connect(sw.MouseButton1Click, function() select(entry.name) end)
		end
		select(default, true)
	end

	-- Выбор темы (цветные кружки)
	function tab.Swatches(text, names, callback)
		local row = baseRow(48)
		new("TextLabel", {
			Position = UDim2.new(0, 14, 0, 0),
			Size = UDim2.new(0.4, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			TextColor3 = "@text",
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)
		local buttons = {}
		local function select(name, silent)
			for n, b in pairs(buttons) do
				local on = (n == name)
				tween(b.stroke, 0.25, { Transparency = on and 0 or 0.85 })
				tween(b.scale, 0.35, { Scale = on and 1.2 or 1 }, Enum.EasingStyle.Back)
			end
			if not silent then task.spawn(callback, name) end
		end
		for i, name in ipairs(names) do
			local th = THEMES[name]
			local sw = new("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14 - (#names - i) * 32, 0.5, 0),
				Size = UDim2.fromOffset(24, 24),
				BackgroundColor3 = Color3.new(1, 1, 1),
				Text = "",
				AutoButtonColor = false,
				ZIndex = 3,
			}, row)
			roundCorner(sw)
			new("UIGradient", {
				Color = ColorSequence.new(th.accent, th.accent2),
				Rotation = 45,
			}, sw)
			buttons[name] = {
				stroke = stroke(sw, Color3.new(1, 1, 1), 2, 0.85),
				scale = new("UIScale", {}, sw),
			}
			connect(sw.MouseButton1Click, function() select(name) end)
		end
		select("Dragon", true)
	end

	table.insert(tabs, tab)
	return tab
end

