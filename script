local function showPad(show)
	if not UIS.TouchEnabled then return end
	if show then
		flyPad.Visible = true
		tween(padScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		touchUp, touchDown = false, false
		tween(padScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.delay(0.22, function()
			if not Fly.enabled then flyPad.Visible = false end
		end)
	end
end

