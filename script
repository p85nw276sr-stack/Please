	local function mkButton(text, pos, bgKey, textKey)
		local b = new("TextButton", {
			Position = pos,
			Size = UDim2.new(0.5, -24, 0, 36),
			BackgroundColor3 = bgKey,
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = textKey,
			AutoButtonColor = false,
		}, card)
		corner(b, 8)
		connect(b.MouseEnter, function() tween(b, 0.15, { BackgroundTransparency = 0.2 }) end)
		connect(b.MouseLeave, function() tween(b, 0.2, { BackgroundTransparency = 0 }) end)
		return b
	end
	local cancelBtn = mkButton("Cancel", UDim2.fromOffset(18, 152), "@element", "@sub")
	local copyBtn = mkButton("Copy", UDim2.new(0.5, 6, 0, 152), "@accent", Color3.new(1, 1, 1))

	Dialog.overlay, Dialog.holder, Dialog.hScale = overlay, holder, hScale
	Dialog.card, Dialog.hStroke, Dialog.box, Dialog.status = card, hStroke, box, status

	function Dialog.setStatus(text, kind)
		status.Text = text
		local col = (kind == "err" and rgb(235, 90, 100)) or (kind == "ok" and rgb(90, 210, 130)) or THEME.accent2
		tween(status, 0.2, { TextColor3 = col })
	end

	local function submit()
		if Dialog.busy then return end
		Dialog.busy = true
		Dialog.token = Dialog.token + 1
		local my = Dialog.token
		task.spawn(function()
			local ok = Avatar.copy(box.Text, function(txt, kind)
				if Dialog.token == my then Dialog.setStatus(txt, kind) end
			end, function() return Dialog.token ~= my end)
			if Dialog.token ~= my then return end
			Dialog.busy = false
			if ok then
				task.wait(1.2)
				if Dialog.token == my then
					Dialog.close()
					if Dialog.onDone then Dialog.onDone(true) end
				end
			end
		end)
	end

	connect(copyBtn.MouseButton1Click, submit)
	connect(box.FocusLost, function(enter) if enter then submit() end end)
	connect(cancelBtn.MouseButton1Click, function()
		Dialog.token = Dialog.token + 1
		Dialog.busy = false
		Dialog.close()
		if Dialog.onDone then Dialog.onDone(false) end
	end)
end

function Dialog.open(onDone)
	Dialog.build()
	Dialog.onDone = onDone
	Dialog.busy = false
	Dialog.token = Dialog.token + 1
	Dialog.setStatus("", "info")
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local fit = math.clamp(math.min(vp.X / 360, vp.Y / 300), 0.6, 1)

	Dialog.overlay.Visible = true
	Dialog.hScale.Scale = 0.85 * fit
	tween(Dialog.overlay, 0.3, { BackgroundTransparency = 0.5 })
	tween(Dialog.hScale, 0.5, { Scale = fit }, Enum.EasingStyle.Back)
	tween(Dialog.card, 0.3, { GroupTransparency = 0 })
	tween(Dialog.hStroke, 0.3, { Transparency = 0 })
	task.delay(0.4, function()
		if Dialog.overlay.Visible then Dialog.box:CaptureFocus() end
	end)
end

function Dialog.close()
	if not Dialog.overlay then return end
	tween(Dialog.overlay, 0.3, { BackgroundTransparency = 1 })
	tween(Dialog.hScale, 0.3, { Scale = 0.85 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
	tween(Dialog.card, 0.25, { GroupTransparency = 1 })
	tween(Dialog.hStroke, 0.25, { Transparency = 1 })
	task.delay(0.35, function()
		if Dialog.token and Dialog.overlay then Dialog.overlay.Visible = false end
	end)
end

