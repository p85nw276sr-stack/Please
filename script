local ControlModule
task.spawn(function()
	local ok, mod = pcall(function()
		local ps = LocalPlayer:WaitForChild("PlayerScripts", 5)
		local pm = ps:WaitForChild("PlayerModule", 5)
		return require(pm:WaitForChild("ControlModule", 5))
	end)
	if ok then ControlModule = mod end
end)

local function getChar()
	local char = LocalPlayer.Character
	return char,
		char and char:FindFirstChild("HumanoidRootPart"),
		char and char:FindFirstChildOfClass("Humanoid")
end

local function respawn()
	local char, _, hum = getChar()
	pcall(function() if hum then hum.Health = 0 end end)
	pcall(function() if char then char:BreakJoints() end end)
end

local function getMoveDir(humanoid, camCF)
	if ControlModule then
		local ok, mv = pcall(ControlModule.GetMoveVector, ControlModule)
		if ok and typeof(mv) == "Vector3" then
			return camCF.RightVector * mv.X + camCF.LookVector * -mv.Z
		end
	end
	local md = humanoid.MoveDirection
	if md.Magnitude < 0.01 then return Vector3.zero end
	local look, right = camCF.LookVector, camCF.RightVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or Vector3.new(0, 0, -1)
	local flatRight = Vector3.new(right.X, 0, right.Z).Unit
	return look * md:Dot(flatLook) + right * md:Dot(flatRight)
end

local function getVertical()
	local up = keys[Enum.KeyCode.Space] or keys[Enum.KeyCode.E] or touchUp
	local down = keys[Enum.KeyCode.Q] or keys[Enum.KeyCode.LeftControl] or touchDown
	return (up and 1 or 0) - (down and 1 or 0)
end

local function cleanupFly()
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if flyVel then flyVel:Destroy() flyVel = nil end
	if flyGyro then flyGyro:Destroy() flyGyro = nil end
	local _, _, hum = getChar()
	if hum then hum.PlatformStand = false end
end

local function startFly()
	cleanupFly()
	local _, hrp, hum = getChar()
	if not hrp or not hum then return end

	flyVel = new("BodyVelocity", {
		MaxForce = Vector3.new(9e9, 9e9, 9e9),
		Velocity = Vector3.zero,
	}, hrp)
	flyGyro = new("BodyGyro", {
		MaxTorque = Vector3.new(9e9, 9e9, 9e9),
		P = 9e4,
		D = 1e3,
		CFrame = hrp.CFrame,
	}, hrp)
	hum.PlatformStand = true

	flyConn = RunService.RenderStepped:Connect(function(dt)
		local _, rootPart, humanoid = getChar()
		local cam = workspace.CurrentCamera
		if not (rootPart and humanoid and cam and flyVel and flyVel.Parent == rootPart) then return end

		humanoid.PlatformStand = true
		local camCF = cam.CFrame
		local target = getMoveDir(humanoid, camCF) + Vector3.new(0, getVertical(), 0)
		if target.Magnitude > 1 then target = target.Unit end

		flyVel.Velocity = flyVel.Velocity:Lerp(target * Fly.speed, math.clamp(dt * 12, 0, 1))

		local look = camCF.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.05 then
			flyGyro.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + flat)
		end
	end)
end

local function setFly(state)
	Fly.enabled = state
	if state then startFly() else cleanupFly() end
	showPad(state)
end

connect(UIS.InputBegan, function(input, gp)
