		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
	}, layer)
	roundCorner(r)
	tween(r, 0.7, { Size = UDim2.fromScale(5, 5), BackgroundTransparency = 1 }).Completed:Connect(function()
		r:Destroy()
	end)
end

