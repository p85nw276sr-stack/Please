-- FE FUNCTION: Copy Avatar
-- Roblox не даёт клиенту менять внешность для других игроков напрямую.
-- Поэтому используется официальный запрос сохранения аватара: ты сам
-- подтверждаешь окно Roblox, аватар сохраняется на аккаунте и после
-- респавна его видят все. Наденутся только вещи, которые есть у тебя.
----------------------------------------------------------------
local Avatar = { active = false, autoRespawn = true }

local function promptSaveAvatar(desc, rig)
	local AES = game:GetService("AvatarEditorService")
	local done, result = false, nil
	local conn = AES.PromptSaveAvatarCompleted:Connect(function(r)
		result = r
		done = true
	end)
	local ok, err = pcall(function() AES:PromptSaveAvatar(desc, rig) end)
	if not ok then
		conn:Disconnect()
		return nil, tostring(err)
	end
	local t0 = os.clock()
	while not done and os.clock() - t0 < 120 do task.wait(0.1) end
	conn:Disconnect()
	return result
end

-- status(text, kind) - сообщение пользователю, cancelled() - true, если окно закрыли
function Avatar.copy(username, status, cancelled)
	username = string.match(username or "", "^%s*(.-)%s*$")
	if username == "" then
		status("Введите ник", "err")
		return false
	end

	status("Ищу игрока...", "info")
	local okId, userId = pcall(function() return Players:GetUserIdFromNameAsync(username) end)
	if not okId or type(userId) ~= "number" then
		status("Игрок с таким ником не найден", "err")
		return false
	end

	status("Загружаю аватар...", "info")
	local okD, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
	if not okD or not desc then
		status("Не удалось загрузить аватар", "err")
		return false
	end

	-- запоминаем свой аватар, чтобы потом можно было вернуть
	if not Avatar.origDesc then
		local okO, d = pcall(function() return Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId) end)
		if okO then Avatar.origDesc = d end
		local _, _, hum = getChar()
		Avatar.origRig = hum and hum.RigType or Enum.HumanoidRigType.R15
	end

	local rig = Enum.HumanoidRigType.R15
	local okI, info = pcall(function() return Players:GetCharacterAppearanceInfoAsync(userId) end)
	if okI and type(info) == "table" and info.playerAvatarType == "R6" then
		rig = Enum.HumanoidRigType.R6
	end

	status("Подтвердите окно Roblox...", "info")
	local result, err = promptSaveAvatar(desc, rig)
	if cancelled and cancelled() then return false end

	if result == Enum.AvatarPromptResult.Success then
		Avatar.active = true
		status("Готово! Аватар сохранён.", "ok")
		if Avatar.autoRespawn then
			task.delay(1.4, respawn)
		else
			toast("Аватар сохранён. Сделай респавн, чтобы его увидели все.", "ok")
		end
		return true
	end

	-- не вышло: хотя бы локальный предпросмотр
	local _, _, hum = getChar()
	if hum then pcall(function() hum:ApplyDescription(desc) end) end
	if err then
		status("Roblox отклонил запрос. Применено только у тебя.", "err")
	else
		status("Не сохранено (нужны вещи на аккаунте). Видно только тебе.", "err")
	end
	return false
end

function Avatar.restore()
	if not Avatar.origDesc then
		toast("Нечего восстанавливать", "err")
		return
	end
	task.spawn(function()
		toast("Подтверди возврат аватара в окне Roblox", "info")
		local result = promptSaveAvatar(Avatar.origDesc, Avatar.origRig or Enum.HumanoidRigType.R15)
		if result == Enum.AvatarPromptResult.Success then
			Avatar.active = false
			toast("Твой аватар возвращён", "ok")
			if Avatar.autoRespawn then task.delay(1.2, respawn) end
		else
			toast("Не удалось вернуть аватар", "err")
		end
	end)
end

