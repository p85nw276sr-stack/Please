		local h = char:FindFirstChild("Head")
		return h and h.Position
	end
	local r = char:FindFirstChild("HumanoidRootPart")
	if not r then return nil end
	if kind == "Feet" then return r.Position - Vector3.new(0, 3, 0) end
	return r.Position
