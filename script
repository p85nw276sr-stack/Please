-- WalkSpeed, JumpPower, Infinite Jump, Noclip, God Mode
----------------------------------------------------------------
local function setWalk(on)
	State.walkOn = on
	local _, _, hum = getChar()
	if not hum then return end
	if on then
		orig.walk = hum.WalkSpeed
	else
		hum.WalkSpeed = orig.walk or 16
	end
end

local function setJump(on)
	State.jumpOn = on
	local _, _, hum = getChar()
	if not hum then return end
	if on then
		orig.useJP, orig.jp, orig.jh = hum.UseJumpPower, hum.JumpPower, hum.JumpHeight
	elseif orig.useJP ~= nil then
		hum.UseJumpPower = orig.useJP
		hum.JumpPower = orig.jp
		hum.JumpHeight = orig.jh
	end
end

local noclipTouched = setmetatable({}, { __mode = "k" })
local function setNoclip(on)
	State.noclip = on
	if not on then
		for part in pairs(noclipTouched) do
			if part and part.Parent then part.CanCollide = true end
		end
		noclipTouched = setmetatable({}, { __mode = "k" })
	end
end

local function setGod(on)
	State.god = on
	if not on then
		local char, _, hum = getChar()
		if hum then
			pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true) end)
		end
		local ff = char and char:FindFirstChild("DeltaFF")
		if ff then ff:Destroy() end
	end
end

connect(RunService.Heartbeat, function()
	local char, _, hum = getChar()
	if not hum then return end

	if State.walkOn and hum.WalkSpeed ~= State.walk then
		hum.WalkSpeed = State.walk
	end
	if State.jumpOn then
		if not hum.UseJumpPower then hum.UseJumpPower = true end
		if hum.JumpPower ~= State.jump then hum.JumpPower = State.jump end
	end
	if State.god then
		if hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
		if hum:GetStateEnabled(Enum.HumanoidStateType.Dead) then
			hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		end
		if not char:FindFirstChild("DeltaFF") then
			local ff = Instance.new("ForceField")
			ff.Name = "DeltaFF"
			ff.Visible = false
			ff.Parent = char
		end
	end
end)

connect(RunService.Stepped, function()
	if not State.noclip then return end
	local char = LocalPlayer.Character
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") and p.CanCollide then
			noclipTouched[p] = true
			p.CanCollide = false
		end
	end
end)

connect(UIS.JumpRequest, function()
	if not State.infJump then return end
	local _, _, hum = getChar()
	if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)

connect(LocalPlayer.Idled, function()
	if not State.antiAfk then return end
	pcall(function()
		local vu = game:GetService("VirtualUser")
		vu:CaptureController()
		vu:ClickButton2(Vector2.new())
	end)
end)

